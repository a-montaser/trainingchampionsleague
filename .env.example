# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Postgres connection string.
#   Local Docker : postgresql://postgres:postgres@localhost:5432/tcl
#   Neon         : use the POOLED connection string from the Neon dashboard
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tcl

# Secret used to derive session tokens. Must be at least 32 characters.
# Generate one with:  openssl rand -base64 32
SESSION_SECRET=replace-me-with-at-least-32-random-characters

# Only addresses on this domain may sign up on the participant site.
ALLOWED_EMAIL_DOMAIN=@vodafone.com
